# =============================================================================
# UR Platform — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# =============================================================================

# --- Database (MySQL — required for user + loyalty persistence) ---
DATABASE_URL="mysql://root:@127.0.0.1:3306/ur_platform"

# --- Supabase (auth) ---
# EXPO_PUBLIC_* keys are safe for the mobile app (anon key only).
# Supabase access tokens are ES256 — verified via supabase.auth.getUser(), not JWT_SECRET.
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only Supabase (optional — falls back to EXPO_PUBLIC_* / built-in dev project)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Google Cloud AI (SERVER ONLY — never use EXPO_PUBLIC_ for these) ---
# Server-only Gemini API key for ContentMate / LinguaMate (Google AI Studio)
# Get yours at https://aistudio.google.com/apikey (AQ… or AIza… prefix)
# NEVER use EXPO_PUBLIC_ — keep on server only
CONTENTMATE_GEMINI_API_KEY="your-gemini-api-key"

# Or use Vertex AI instead (requires service account):
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GEMINI_MODEL="gemini-2.5-flash"
GOOGLE_IMAGEN_MODEL="imagen-3.0-generate-002"

# Path to a GCP service account JSON key with Vertex AI User role
GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/your-service-account-key.json"

# Legacy Manus Forge (optional — used by image/voice/storage helpers, not chat)
BUILT_IN_FORGE_API_URL="https://forge.manus.im"
BUILT_IN_FORGE_API_KEY=""

# Optional — GitHub sync for TechBuilder / GameForge Build tab
GITHUB_TOKEN=""

# Forge cloud execution — auto-wipe temp workspaces after N minutes (default 30)
FORGE_SESSION_TTL_MINUTES=30

# --- Platform owner (ONLY you — admin + guardrail bypass) ---
# Set your Supabase user UUID (from Supabase dashboard → Authentication → Users)
PLATFORM_OWNER_SUPABASE_ID="your-supabase-user-uuid"
# Or your login email (must match exactly)
PLATFORM_OWNER_EMAIL="your-email@example.com"
# Legacy Manus OAuth owner ID (if applicable)
OWNER_OPEN_ID=""

# --- Auth / session ---
# HS256 secret for Manus/OAuth session cookies only — NOT for Supabase tokens (ES256).
JWT_SECRET="your-jwt-secret"
VITE_APP_ID=""
OAUTH_SERVER_URL=""
OWNER_OPEN_ID=""

# Comma-separated allowed browser origins (production)
CORS_ALLOWED_ORIGINS="http://localhost:8082,https://urplatform.llc,https://www.urplatform.llc"
APP_URL="https://urplatform.llc"
EXPO_PUBLIC_APP_URL="https://urplatform.llc"

# Production API (mobile app + cross-device chat sync). Web on urplatform.llc can use same origin.
# EXPO_PUBLIC_API_BASE_URL="https://urplatform.llc"

# --- Launch promotion (30-day creator tier window) ---
# ISO date when the 300-creator contest clock starts (used on homepage + landing).
EXPO_PUBLIC_LAUNCH_DATE="2026-08-12T05:00:00.000Z"

# --- Commerce / dropship / affiliate (add when approved by each provider) ---
# Printful POD — https://developers.printful.com/
PRINTFUL_API_KEY=""
PRINTFUL_STORE_ID=""
# Printify POD — https://developers.printify.com/
PRINTIFY_API_TOKEN=""
PRINTIFY_SHOP_ID=""
# CJ Dropshipping — https://developers.cjdropshipping.com/
CJ_DROPSHIPPING_API_KEY=""
# Affiliate tracking (no API needed for basic links — set after program approval)
WALMART_TRACKING_ID=""
AMAZON_ASSOCIATE_TAG=""
# Stripe (after LLC fix)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Expo app (safe to expose) ---
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
# Web dev: Metro on :8082, API on :3000 (auto-detected). Production: https://urplatform.llc (same host as API).
