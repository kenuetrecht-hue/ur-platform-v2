# =============================================================================
# UR Platform — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to git.
# NEVER paste real API keys, tokens, or private keys into THIS file.
# =============================================================================

# --- Database (MySQL — required for user + loyalty persistence) ---
DATABASE_URL="mysql://root:@127.0.0.1:3306/ur_platform"

# --- Supabase (auth) ---
# EXPO_PUBLIC_* keys are safe for the mobile app (anon key only).
# Supabase access tokens are ES256 — verified via supabase.auth.getUser(), not JWT_SECRET.
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only Supabase (optional — falls back to EXPO_PUBLIC_* / built-in dev project)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Google Cloud AI (SERVER ONLY — never use EXPO_PUBLIC_ for these) ---
# Server-only Gemini API key for ContentMate / LinguaMate (Google AI Studio)
# Get yours at https://aistudio.google.com/apikey (AQ… or AIza… prefix)
# NEVER use EXPO_PUBLIC_ — keep on server only
CONTENTMATE_GEMINI_API_KEY="your-gemini-api-key"

# Or use Vertex AI instead (requires service account):
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GEMINI_MODEL="gemini-3.6-flash"
GOOGLE_IMAGEN_MODEL="imagen-3.0-generate-002"

# Path to a GCP service account JSON key with Vertex AI User role
GOOGLE_APPLICATION_CREDENTIALS="C:/path/to/your-service-account-key.json"

# Legacy Manus Forge (optional — used by image/voice/storage helpers, not chat)
BUILT_IN_FORGE_API_URL="https://forge.manus.im"
BUILT_IN_FORGE_API_KEY=""

# Optional — GitHub sync for TechBuilder / GameForge Build tab
GITHUB_TOKEN=""

# Forge cloud execution — auto-wipe temp workspaces after N minutes (default 30)
FORGE_SESSION_TTL_MINUTES=30

# --- Platform owner (ONLY you — admin + guardrail bypass) ---
# Set your Supabase user UUID (from Supabase dashboard → Authentication → Users)
PLATFORM_OWNER_SUPABASE_ID="your-supabase-user-uuid"
# Or your login email (must match exactly)
PLATFORM_OWNER_EMAIL="your-email@example.com"
# Optional separate drive / NAS for IRS-ready AI + ops archives (JSON).
# Example: D:/UR-Platform-Audit   or   /mnt/backup/ur-platform-audit
# If unset, files go to data/owner-audit-archive/ on this server (gitignored).
OWNER_AUDIT_BACKUP_DIR=""
# Legacy Manus OAuth owner ID (if applicable)
OWNER_OPEN_ID=""

# --- Auth / session ---
# HS256 secret for Manus/OAuth session cookies only — NOT for Supabase tokens (ES256).
JWT_SECRET="your-jwt-secret"
VITE_APP_ID=""
OAUTH_SERVER_URL=""
OWNER_OPEN_ID=""

# Comma-separated allowed browser origins (production)
CORS_ALLOWED_ORIGINS="http://localhost:8082,https://urplatform.llc,https://www.urplatform.llc"
APP_URL="https://urplatform.llc"
EXPO_PUBLIC_APP_URL="https://urplatform.llc"

# Production API (mobile app + cross-device chat sync). Web on urplatform.llc can use same origin.
# EXPO_PUBLIC_API_BASE_URL="https://urplatform.llc"

# --- Local testing: skip 18+ ID upload (IGNORED in production) ---
# Default is skip while running `pnpm dev`. Set false when you are ready to test ID + selfie.
DEV_SKIP_AGE_KYC=true

# --- Launch promotion (30-day creator tier window) ---
# ISO date when the 300-creator contest clock starts (used on homepage + landing).
EXPO_PUBLIC_LAUNCH_DATE="2026-08-12T05:00:00.000Z"

# --- Commerce / dropship / affiliate (replace placeholders after each provider approves the LLC) ---
# Never use EXPO_PUBLIC_ for these. Placeholder your-* values are ignored until replaced.
# Printful POD — https://developers.printful.com/
PRINTFUL_API_KEY="your-printful-api-key"
PRINTFUL_STORE_ID="your-printful-store-id"
# Printify POD — https://developers.printify.com/
PRINTIFY_API_TOKEN="your-printify-api-token"
PRINTIFY_SHOP_ID="your-printify-shop-id"
# CJ Dropshipping — https://developers.cjdropshipping.com/
CJ_DROPSHIPPING_API_KEY="your-cj-dropshipping-api-key"
# Affiliate tracking (no API needed for basic links — set after program approval)
WALMART_TRACKING_ID="your-walmart-tracking-id"
AMAZON_ASSOCIATE_TAG="your-amazon-associate-tag"
# Stripe (after LLC fix)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Cloudflare Turnstile (bot check on login, signup, landing demo, 18+ ID) ---
# Dashboard: https://dash.cloudflare.com/ → Turnstile → Add widget for urplatform.llc
# Site key is public (widget). Secret is SERVER ONLY — never EXPO_PUBLIC_.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Mux Video (PRIMARY video engine — server only, never EXPO_PUBLIC_) ---
# Dashboard: https://dashboard.mux.com/ → Settings → Access Tokens
# Direct upload + adaptive HLS + signed pay-per-view for class replays.
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
# Webhook signing secret — Settings → Webhooks → https://urplatform.llc/api/mux/webhook
MUX_WEBHOOK_SECRET=""
# Signing key for paid / private playback (Settings → Signing Keys)
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""

# --- Social posting (owner accounts only until Ayrshare Business) ---
# Ayrshare personal / Premium: https://app.ayrshare.com → API Key
# Do NOT set AYRSHARE_PROFILE_KEY until the Business plan is ready.
AYRSHARE_API_KEY=""
# AYRSHARE_PROFILE_KEY=""
# Buffer personal API: https://buffer.com → Account → API
BUFFER_ACCESS_TOKEN=""
BUFFER_FACEBOOK_PROFILE_ID=""
BUFFER_INSTAGRAM_PROFILE_ID=""
BUFFER_TWITTER_PROFILE_ID=""
BUFFER_LINKEDIN_PROFILE_ID=""
BUFFER_TIKTOK_PROFILE_ID=""
BUFFER_YOUTUBE_PROFILE_ID=""
# Required only when BOTH Ayrshare and Buffer can post to the same network.
# One value per network: ayrshare  OR  buffer  — never both.
# SOCIAL_ROUTE_FACEBOOK=ayrshare
# SOCIAL_ROUTE_INSTAGRAM=ayrshare
# SOCIAL_ROUTE_TWITTER=buffer
# SOCIAL_ROUTE_LINKEDIN=ayrshare
# SOCIAL_ROUTE_TIKTOK=ayrshare
# SOCIAL_ROUTE_YOUTUBE=ayrshare

# --- Expo app (safe to expose) ---
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
# Optional Android installer hosted on your site (HTTPS .apk). Leave empty until you upload a build.
# When set, /download offers this file. Visitors still do not need Google Play.
# EXPO_PUBLIC_ANDROID_APK_URL="https://urplatform.llc/downloads/ur.apk"
# Web dev: Metro on :8082, API on :3000 (auto-detected). Production: https://urplatform.llc (same host as API).
