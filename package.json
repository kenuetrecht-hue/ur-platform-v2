{
  "name": "app-template",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "predev": "node scripts/free-dev-ports.mjs && node scripts/ensure-mysql-running.js && node scripts/print_qr_terminal.mjs",
    "predev:web": "node scripts/free-dev-ports.mjs && node scripts/ensure-mysql-running.js && node scripts/print-web-url.mjs",
    "dev": "concurrently --names api,metro --prefix-colors blue,magenta \"pnpm dev:server\" \"pnpm dev:metro\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch --clear-screen=false --include ./server --include ./lib --include ./shared server/_core/index.ts",
    "dev:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --lan --port 8082",
    "dev:web": "concurrently --names api,web --prefix-colors blue,green \"pnpm dev:server\" \"pnpm dev:web:metro\"",
    "dev:web:metro": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --web --port 8082",
    "start:expo": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --lan --port 8082",
    "expo": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 expo start --lan --port 8082",
    "build": "esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:web": "cross-env EXPO_USE_METRO_WORKSPACE_ROOT=1 expo export --platform web",
    "build:all": "pnpm build && pnpm build:web",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "db:setup": "node scripts/run-all-migrations.js",
    "db:check": "node scripts/check-db.js",
    "db:start-mysql": "powershell -ExecutionPolicy Bypass -File scripts/start-mysql-windows.ps1",
    "db:configure-mysql": "powershell -ExecutionPolicy Bypass -File scripts/configure-mysql-windows.ps1",
    "db:mysql-dev": "powershell -ExecutionPolicy Bypass -File scripts/start-mysql-dev.ps1",
    "db:ensure": "node scripts/ensure-mysql-database.js",
    "db:ai-chat-sync": "node scripts/run-ai-chat-migration.js",
    "db:mysql:up": "docker compose -f docker-compose.mysql.yml up -d",
    "db:mysql:down": "docker compose -f docker-compose.mysql.yml down",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "qr": "node scripts/generate_qr.mjs",
    "qr:terminal": "node scripts/print_qr_terminal.mjs",
    "smoke:web": "node scripts/smoke-web-auth.mjs",
    "smoke:routes": "node scripts/smoke-web-routes.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.56.2",
    "@babylonjs/loaders": "^8.56.2",
    "@dimforge/rapier3d-compat": "^0.19.2",
    "@expo/vector-icons": "^15.0.3",
    "@google-cloud/vertexai": "^1.12.0",
    "@google/generative-ai": "^0.24.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.12",
    "@react-navigation/elements": "^2.9.2",
    "@react-navigation/native": "^7.1.25",
    "@supabase/supabase-js": "^2.110.6",
    "@tanstack/react-query": "^5.90.12",
    "@trpc/client": "11.7.2",
    "@trpc/react-query": "11.7.2",
    "@trpc/server": "11.7.2",
    "axios": "^1.13.2",
    "cannon-es": "^0.20.0",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.7",
    "expo": "~54.0.36",
    "expo-audio": "~1.1.0",
    "expo-build-properties": "^1.0.10",
    "expo-constants": "~18.0.12",
    "expo-document-picker": "~14.0.7",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.10",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.15",
    "expo-web-browser": "~15.0.10",
    "express": "^4.22.1",
    "google-auth-library": "^10.9.1",
    "jose": "6.1.0",
    "mysql2": "^3.16.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "superjson": "^1.13.3",
    "tailwind-merge": "^2.6.0",
    "ws": "^8.21.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.1.17",
    "@types/ws": "^8.18.1",
    "babel-preset-expo": "~54.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.7.4",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.12.0"
}
